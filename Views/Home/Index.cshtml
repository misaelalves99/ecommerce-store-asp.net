@{
    ViewData["Title"] = "Página Inicial";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Home/index.css" />
}

<div class="container text-center mt-5">
    <h1 class="mb-4">Bem-vindo ao Painel Administrativo</h1>

    <div class="row justify-content-center">
        <div class="col-md-3 mb-3">
            <a asp-controller="Brand" asp-action="Index" class="btn btn-outline-primary btn-lg w-100">Gerenciar Marcas</a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-controller="Category" asp-action="Index" class="btn btn-outline-success btn-lg w-100">Gerenciar Categorias</a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark btn-lg w-100">Gerenciar Produtos</a>
        </div>
    </div>
</div>
