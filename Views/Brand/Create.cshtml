@model ECommerceStore.Models.Brand

@{
    ViewData["Title"] = "Adicionar Marca";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Brand/create.css" />
}

<h1>Adicionar Marca</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Name" class="control-label">Nome da Marca</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success mt-2">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
